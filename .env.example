# Приклад конфігурації сервера. Скопіюйте в .env і запустіть:
#   node --env-file=.env server/src/index.js      (або: npm run start:env)
# Усі параметри необов'язкові: значення нижче збігаються зі стандартними.

# Мережа
PORT=3000
HOST=0.0.0.0

# production: роздавати зібраний клієнт із client/dist; development: лише API і WebSocket
NODE_ENV=production

# Каталоги: логи матчів (NDJSON) і зібраний клієнт
LOG_DIR=./logs
# STATIC_DIR=./client/dist

# Ліміти
MAX_ROOMS=20
MAX_PLAYERS_PER_ROOM=8
MAX_CONNECTIONS=200
MAX_BODY_BYTES=4096

# WebSocket
WS_MAX_PAYLOAD=16384
AUTH_TIMEOUT_MS=5000
HEARTBEAT_MS=15000
MAX_BUFFERED_BYTES=1048576
RATE_LIMIT_PER_SEC=20
RATE_LIMIT_BURST=40

# Час, через який порожню кімнату (ніхто не зайшов) буде видалено, і ліміт на коректне завершення
EMPTY_ROOM_TTL_MS=60000
SHUTDOWN_TIMEOUT_MS=5000
