{
  "name": "dogfight",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Dogfight: Lab 4 - Node.js (EventEmitter, Streams, WebSocket)",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace=client",
    "start": "node server/src/index.js",
    "start:env": "node --env-file=.env server/src/index.js",
    "test": "npm test --workspaces --if-present",
    "assets:generate": "npm run assets:generate --workspace=client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
